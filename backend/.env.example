# Default: a local SQLite file, no separate database server needed.
DATABASE_URL=sqlite:///./aose.db
# To use Postgres instead, uncomment and adjust:
# DATABASE_URL=postgresql+psycopg://aose:aose@localhost:5432/aose

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
CORS_ORIGINS=http://localhost:5173
STATIC_DIR=static

# The app is served at http://<host>:<port>/AOSE by default. Set to an
# empty string to serve at the root ("/") instead.
URL_PREFIX=/AOSE
